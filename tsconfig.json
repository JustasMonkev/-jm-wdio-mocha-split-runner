{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./build",
    "rootDir": "./src",
    "types": ["node", "mocha", "webdriverio", "@wdio/mocha-framework"]
  },
  "include": [
    "src/**/*"
  ]
}
